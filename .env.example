# Copy to .env.local (never commit it). On Vercel, set the same names under Project Settings > Environment Variables.

# Offline benchmark runs (benchmark/)
GROQ_API_KEY=
GEMINI_API_KEY=

# Live site (web/), Phase 6
DATABASE_URL=                # Neon pooled connection string (votes, quiz answers)
UPSTASH_REDIS_REST_URL=      # rate limits, daily cap, battle state, answer cache
UPSTASH_REDIS_REST_TOKEN=
LLM_API_KEY=                 # arena models; a Groq API key
LLM_BASE_URL=                # optional; default https://api.groq.com/openai/v1
DAILY_SPEND_CAP=             # max live LLM calls per UTC day; unset or 0 turns the arena off
RATE_LIMIT_SALT=             # random string; salts the IP hash used for rate-limit keys
URDUBENCH_MEMORY_BACKEND=    # 1 = in-memory store for local runs only (ignored on Vercel)

# Phase 7 and 8
EMBEDDING_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=         # for signature verification
